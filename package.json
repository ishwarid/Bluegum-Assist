{
  "name": "bluegum-assist",
  "version": "0.1.0",
  "private": true,
  "description": "AI support assistant for a fictional Australian bank: retrieval with citations, tool calling with human approval, and an eval harness.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:retrieval": "tsx evals/run-retrieval.ts",
    "eval": "tsx evals/run-assistant.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.59",
    "@ai-sdk/provider": "^4.0.26",
    "@ai-sdk/react": "^4.0.140",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "ai": "^7.0.137",
    "minisearch": "^7.2.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
