# Free key from https://console.groq.com/keys. Without it, the app uses
# scripted demo replies (search, card checks and approvals still work).
GROQ_API_KEY=

# Optional. Any Groq chat model with tool calling.
GROQ_MODEL=llama-3.3-70b-versatile

# Required in production. Signs approval requests so they can't be forged.
# Generate one with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# Optional limits that protect the free quota.
DAILY_MESSAGE_LIMIT=30
GLOBAL_MESSAGES_PER_MINUTE=25

# Set to "demo" to force scripted replies even when a key is set.
# AI_PROVIDER=demo
